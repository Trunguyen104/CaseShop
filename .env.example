# ==============================================================
# CaseShop - Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual credentials
# ==============================================================

# Database Connection (PostgreSQL)
DEFAULT_CONNECTION=Host=localhost;Database=CaseShopDb;Username=postgres;Password=your_db_password

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Default Initial Admin Account (Seeded on first startup if not exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YourStrongPasswordHere!

# PayOS QR payment (never commit real secrets)
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_RETURN_URL=https://your-domain.example/checkout/payment-return
PAYOS_CANCEL_URL=https://your-domain.example/checkout/payment-cancel

# SMTP order confirmation email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=no-reply@your-domain.example
SMTP_FROM_NAME=CaseShop
SMTP_SUPPORT_EMAIL=support@your-domain.example
