@inject IJSRuntime JS
@implements IAsyncDisposable

<section class="space-y-4" aria-label="Lớp và thuộc tính thiết kế">
    <div class="flex flex-wrap gap-2">
        <button class="studio-action" disabled="@(!_state.CanUndo)" @onclick='() => Run("undo")'>↶ Hoàn tác</button>
        <button class="studio-action" disabled="@(!_state.CanRedo)" @onclick='() => Run("redo")'>↷ Làm lại</button>
    </div>
    <p class="text-label-sm text-on-surface-variant">@_state.Elements.Count lớp • Chọn một lớp để chỉnh sửa</p>
    @if (_state.Elements.Count == 0)
    {
        <div class="rounded-xl bg-surface-container-low p-4 text-body-sm text-on-surface-variant">Bắt đầu với một sticker, ảnh hoặc dòng chữ từ bảng công cụ.</div>
    }
    @foreach (var layer in _state.Elements)
    {
        <div @key="layer.Id" class="rounded-lg p-2 @(_state.SelectedId == layer.Id ? "bg-surface-container ring-1 ring-primary" : "bg-surface-container-low")">
            <button class="w-full truncate text-left text-label-md font-semibold" @onclick='() => Run("select", null, layer.Id)'>@(layer.Type == "background" ? "Nền: " : layer.Type == "text" ? "Chữ: " : "Ảnh: ")@layer.Name</button>
            <div class="mt-2 flex gap-2">
                @if (layer.Type != "background")
                {
                    <button class="studio-action" disabled="@layer.Locked" aria-label="Ẩn hoặc hiện lớp @layer.Name" @onclick='() => Run("visibility", null, layer.Id)'>@(layer.Hidden ? "Hiện" : "Ẩn")</button>
                    <button class="studio-action" aria-label="Khóa hoặc mở lớp @layer.Name" @onclick='() => Run("lock", null, layer.Id)'>@(layer.Locked ? "Mở khóa" : "Khóa")</button>
                }
                <button class="studio-action" disabled="@layer.Locked" aria-label="Xóa lớp @layer.Name" @onclick='() => Run("delete", null, layer.Id)'>Xóa</button>
            </div>
        </div>
    }
    @if (Selected is { } selected)
    {
        <fieldset disabled="@selected.Locked" class="space-y-4 border-t border-outline-variant pt-4">
            <legend class="text-label-md font-semibold">Thuộc tính lớp</legend>
            @if (selected.Type == "background")
            {
                <p class="text-body-sm text-on-surface-variant">Kéo trực tiếp trên canvas để căn ảnh. Ảnh luôn được giữ tỷ lệ và phủ kín toàn bộ vùng case.</p>
                <div class="flex flex-wrap gap-2">
                    <button class="studio-action studio-action-primary" @onclick='() => Run("center")'>Căn giữa nền</button>
                    <button class="studio-action" @onclick='() => Run("delete")'>Xóa nền</button>
                </div>
            }
            else
            {
            @if (selected.Locked) { <p class="text-body-sm">Mở khóa lớp để chỉnh sửa.</p> }
            <div class="flex flex-wrap gap-2">
                <button class="studio-action" @onclick='() => Run("duplicate")'>Nhân bản</button>
                <button class="studio-action" @onclick='() => Run("forward")'>Đưa lên</button>
                <button class="studio-action" @onclick='() => Run("backward")'>Đưa xuống</button>
                <button class="studio-action" @onclick='() => Run("center")'>Căn giữa</button>
                @if (selected.Type == "sticker")
                {
                    <button class="studio-action studio-action-primary" @onclick="OpenCropDialog">
                        <span class="material-symbols-outlined text-[17px]" aria-hidden="true">crop</span>
                        Cắt ảnh
                    </button>
                }
            </div>
            <label class="studio-label">Chiều rộng: @selected.Width px
                <input type="range" min="20" max="532" value="@selected.Width" @onchange='e => Run("width", e.Value)' />
            </label>
            <label class="studio-label">Độ đậm: @selected.Opacity%
                <input type="range" min="0" max="100" value="@selected.Opacity" @onchange='e => Run("opacity", e.Value)' />
            </label>
            <label class="studio-label">Góc xoay: @selected.Rotation°
                <input type="range" min="-180" max="180" value="@selected.Rotation" @onchange='e => Run("rotation", e.Value)' />
            </label>
            <div class="grid grid-cols-2 gap-2">
                <label class="studio-label">Vị trí X<input type="number" value="@selected.X" @onchange='e => Run("x", e.Value)' /></label>
                <label class="studio-label">Vị trí Y<input type="number" value="@selected.Y" @onchange='e => Run("y", e.Value)' /></label>
            </div>
            @if (selected.Type == "text")
            {
                <label class="studio-label">Nội dung<input type="text" maxlength="100" value="@selected.Name" @onchange='e => Run("text", e.Value)' /></label>
                <label class="studio-label">Phông chữ
                    <select value="@selected.FontFamily" @onchange='e => Run("fontFamily", e.Value)'>
                        <option value="Inter, sans-serif">Inter</option><option value="Arial, sans-serif">Arial</option>
                        <option value="Montserrat, sans-serif">Montserrat</option><option value="Playfair Display, serif">Playfair Display</option>
                        <option value="Dancing Script, cursive">Dancing Script</option><option value="Bebas Neue, sans-serif">Bebas Neue</option>
                        <option value="Georgia, serif">Georgia</option><option value="Courier New, monospace">Courier New</option>
                    </select>
                </label>
                <div class="grid grid-cols-2 gap-2">
                    <label class="studio-label">Cỡ chữ<input type="number" min="8" max="180" value="@selected.FontSize" @onchange='e => Run("fontSize", e.Value)' /></label>
                    <label class="studio-label">Giãn chữ<input type="number" min="-2" max="20" step="0.5" value="@selected.LetterSpacing" @onchange='e => Run("letterSpacing", e.Value)' /></label>
                </div>
                <p class="text-body-sm text-on-surface-variant">Chữ tự co vừa khung. Tăng chiều rộng để hiển thị chữ lớn hơn.</p>
                <label class="studio-label">Màu chữ<input type="color" value="@selected.Color" @onchange='e => Run("color", e.Value)' /></label>
                <div class="flex flex-wrap gap-2" aria-label="Định dạng văn bản">
                    <button class="studio-action font-bold" aria-pressed="@selected.Bold" @onclick='() => Run("bold")'>B</button>
                    <button class="studio-action italic" aria-pressed="@selected.Italic" @onclick='() => Run("italic")'>I</button>
                    <button class="studio-action underline" aria-pressed="@selected.Underline" @onclick='() => Run("underline")'>U</button>
                    <button class="studio-action" aria-pressed="@(selected.TextAlign == "left")" aria-label="Căn trái" @onclick='() => Run("textAlign", "left")'><span class="material-symbols-outlined text-[18px]">format_align_left</span></button>
                    <button class="studio-action" aria-pressed="@(selected.TextAlign == "center")" aria-label="Căn giữa" @onclick='() => Run("textAlign", "center")'><span class="material-symbols-outlined text-[18px]">format_align_center</span></button>
                    <button class="studio-action" aria-pressed="@(selected.TextAlign == "right")" aria-label="Căn phải" @onclick='() => Run("textAlign", "right")'><span class="material-symbols-outlined text-[18px]">format_align_right</span></button>
                </div>
            }
            }
        </fieldset>
    }
</section>

@if (_cropTarget is not null)
{
    <EditorCropDialog ElementId="@_cropTarget.Id" ImageUrl="@_cropTarget.ImageUrl" OnClosed="CloseCropDialog" />
}

@code {
    private EditorState _state = new();
    private DotNetObjectReference<EditorProperties>? _reference;
    private Layer? Selected => _state.Elements.FirstOrDefault(x => x.Id == _state.SelectedId);
    private CropTarget? _cropTarget;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _reference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("CaseShopEditor.observe", _reference);
        }
    }
    [JSInvokable] public Task EditorChanged(EditorState state) => InvokeAsync(() => { _state = state; StateHasChanged(); });
    private async Task Run(string action, object? value = null, string? id = null) => await JS.InvokeVoidAsync("CaseShopEditor.command", action, value, id);

    private async Task OpenCropDialog()
    {
        _cropTarget = await JS.InvokeAsync<CropTarget?>("CaseShopEditor.getSelectedStickerForCrop");
    }

    private Task CloseCropDialog()
    {
        _cropTarget = null;
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        _reference?.Dispose();
    }
    public sealed class CropTarget
    {
        public string Id { get; set; } = "";
        public string ImageUrl { get; set; } = "";
        public string Name { get; set; } = "";
    }
    public sealed class EditorState
    {
        public List<Layer> Elements { get; set; } = [];
        public string? SelectedId { get; set; }
        public bool CanUndo { get; set; }
        public bool CanRedo { get; set; }
    }
    public sealed class Layer
    {
        public string Id { get; set; } = "";
        public string Type { get; set; } = "";
        public string Name { get; set; } = "";
        public int X { get; set; }
        public int Y { get; set; }
        public int Width { get; set; }
        public int Rotation { get; set; }
        public int Opacity { get; set; }
        public bool Hidden { get; set; }
        public bool Locked { get; set; }
        public string Color { get; set; } = "#111111";
        public string FontFamily { get; set; } = "Arial, sans-serif";
        public int FontSize { get; set; }
        public bool Bold { get; set; }
        public bool Italic { get; set; }
        public bool Underline { get; set; }
        public string TextAlign { get; set; } = "center";
        public double LetterSpacing { get; set; }
    }
}
