<button type="@Type"
        form="@Form"
        class="@GetButtonClass()"
        disabled="@(IsDisabled || IsLoading)"
        @onclick="OnClick"
        title="@Title">
    @if (IsLoading)
    {
        <AppSpinner Size="AppSpinner.SpinnerSize.Small" Class="border-on-primary/30 border-t-on-primary" />
        @if (!string.IsNullOrEmpty(LoadingText))
        {
            <span>@LoadingText</span>
        }
    }
    else
    {
        @if (!string.IsNullOrEmpty(Icon))
        {
            <span class="material-symbols-outlined text-[18px]">@Icon</span>
        }
        @if (ChildContent != null)
        {
            @ChildContent
        }
        else if (!string.IsNullOrEmpty(Text))
        {
            <span>@Text</span>
        }
    }
</button>

@code {
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string? Form { get; set; }
    [Parameter] public AppButtonVariant Variant { get; set; } = AppButtonVariant.Primary;
    [Parameter] public bool IsLoading { get; set; } = false;
    [Parameter] public bool IsDisabled { get; set; } = false;
    [Parameter] public string? LoadingText { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    private string GetButtonClass()
    {
        var baseClass = "inline-flex items-center justify-center gap-2 font-label-md text-label-md font-semibold transition-all";
        
        var variantClass = Variant switch
        {
            AppButtonVariant.Primary => "bg-primary text-on-primary hover:bg-neutral-800 shadow-md hover:shadow-lg rounded-lg px-6 h-11 sm:h-12",
            AppButtonVariant.Secondary => "bg-surface-container-lowest text-on-surface hover:bg-surface-container border border-outline-variant shadow-sm rounded-lg px-6 h-11 sm:h-12",
            AppButtonVariant.Ghost => "text-on-surface-variant hover:bg-surface-container hover:text-on-surface rounded-lg px-4 py-2",
            AppButtonVariant.Danger => "bg-error text-on-error hover:bg-red-800 shadow-md rounded-lg px-6 h-11 sm:h-12",
            AppButtonVariant.AdminPrimary => "bg-primary text-on-primary hover:bg-neutral-800 shadow-sm rounded-lg px-4 py-2 h-10",
            AppButtonVariant.AdminSecondary => "bg-surface-container text-on-surface hover:bg-surface-container-high rounded-lg px-4 py-2 h-10",
            AppButtonVariant.AdminGhost => "text-on-surface-variant hover:bg-surface-container hover:text-on-surface rounded-lg px-3 py-1.5",
            _ => "bg-primary text-on-primary rounded-lg px-6 h-11 sm:h-12"
        };

        var disabledClass = (IsDisabled || IsLoading) ? "opacity-50 cursor-not-allowed" : "";

        return $"{baseClass} {variantClass} {disabledClass} {Class}".Trim();
    }

    public enum AppButtonVariant
    {
        Primary,
        Secondary,
        Ghost,
        Danger,
        AdminPrimary,
        AdminSecondary,
        AdminGhost
    }
}
