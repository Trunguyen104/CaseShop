<span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 font-label-sm text-label-sm font-semibold @(IsActive ? "bg-surface-container text-on-surface" : "bg-surface-container-high text-on-surface-variant")">
    <span class="h-1.5 w-1.5 rounded-full @(IsActive ? "bg-emerald-600" : "bg-outline")"></span>
    @(IsActive ? "Đang hoạt động" : "Đã ngừng")
</span>

@code {
    [Parameter] public bool IsActive { get; set; }
}
