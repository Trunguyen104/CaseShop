@using CaseShop.Web.DTOs
@using CaseShop.Web.Components.Shared.UI

<div class="bg-surface-container-lowest p-6 sm:p-7 rounded-xl shadow-md flex flex-col gap-6 @Class">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <h2 class="font-headline-sm text-headline-sm font-semibold text-on-surface tracking-tight">Tóm tắt đơn hàng</h2>
        <span class="font-overline text-overline uppercase tracking-wider px-2 py-0.5 rounded bg-surface-container text-on-surface-variant">@TotalQuantity SẢN PHẨM</span>
    </div>

    <!-- Items -->
    <div class="max-h-[360px] space-y-3 overflow-y-auto">
        @foreach (var item in CartItems)
        {
            <div class="flex gap-3 rounded-xl bg-surface-container-low p-3.5">
                <div class="relative flex h-20 w-20 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-surface-container-high">
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img class="h-full w-full object-contain p-1 drop-shadow-sm" src="@item.ImageUrl" alt="@item.ProductName" />
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-[28px] text-on-surface-variant">image</span>
                    }
                </div>
                <div class="min-w-0 flex-1">
                    <div class="flex items-start justify-between gap-2">
                        <h3 class="font-label-md text-label-md font-semibold text-on-surface">@item.ProductName</h3>
                        <span class="shrink-0 font-label-md text-label-md font-bold text-on-surface">@((item.UnitPrice * item.Quantity).ToString("N0"))₫</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(item.Variant))
                    {
                        <p class="mt-1 font-body-sm text-body-sm text-on-surface-variant line-clamp-1">@item.Variant</p>
                    }
                    <p class="mt-2 font-body-sm text-body-sm text-on-surface-variant">Số lượng: @item.Quantity</p>
                </div>
            </div>
        }
    </div>

    <!-- Breakdown Ledger -->
    <div class="space-y-3 pt-1">
        <div class="flex items-center justify-between font-body-md text-body-md text-on-surface-variant">
            <span>Tạm tính</span>
            <span class="font-medium text-on-surface">@Subtotal.ToString("N0")₫</span>
        </div>
        <div class="flex items-center justify-between font-body-md text-body-md text-on-surface-variant">
            <span class="flex items-center gap-1.5">
                Phí vận chuyển toàn quốc
            </span>
            <span class="font-medium text-on-surface">Miễn phí</span>
        </div>
        <div class="pt-4 border-t border-outline-variant flex items-end justify-between">
            <div>
                <span class="font-headline-sm text-headline-sm font-semibold text-on-surface block tracking-tight">Tổng thanh toán</span>
                <span class="font-body-sm text-body-sm text-on-surface-variant">Đã bao gồm thuế VAT</span>
            </div>
            <div class="text-right">
                <span class="font-headline-md text-headline-md font-bold text-on-surface tracking-tight">@Subtotal.ToString("N0")₫</span>
                <span class="font-overline text-overline block text-on-surface-variant uppercase tracking-wider">VND</span>
            </div>
        </div>
    </div>

    <!-- Submit Button -->
    <div class="space-y-3 pt-1">
        @if (!string.IsNullOrEmpty(SubmitError))
        {
            <div class="p-3 bg-error-container text-on-error-container rounded-lg font-body-sm text-body-sm flex items-start gap-2 animate-in fade-in duration-200">
                <span class="material-symbols-outlined text-[18px] shrink-0 mt-0.5 text-error">error_outline</span>
                <span class="leading-snug">@SubmitError</span>
            </div>
        }
        <AppButton Type="submit"
                   Form="@FormId"
                   Variant="AppButton.AppButtonVariant.Primary"
                   Class="w-full group"
                   IsLoading="IsSubmitting"
                   LoadingText="Đang xử lý..."
                   Text="Đặt hàng ngay">
            <ChildContent>
                <span>Đặt hàng ngay</span>
                <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
            </ChildContent>
        </AppButton>
        <a class="w-full text-center py-2 text-on-surface-variant hover:text-on-surface font-label-md text-label-md font-medium transition-colors block" href="/cart">
            ← Quay lại giỏ hàng
        </a>
    </div>

    <!-- Security Note -->
    <div class="p-3.5 bg-surface-container rounded-lg flex items-center gap-3">
        <span class="material-symbols-outlined text-on-surface text-[20px] shrink-0">lock</span>
        <p class="font-body-sm text-body-sm text-on-surface-variant">
            Thông tin đặt hàng của bạn được bảo mật tuyệt đối. Chúng tôi không chia sẻ dữ liệu liên hệ với bên thứ ba.
        </p>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ClientCartItem> CartItems { get; set; } = Array.Empty<ClientCartItem>();

    [Parameter]
    public int TotalQuantity { get; set; }

    [Parameter]
    public decimal Subtotal { get; set; }

    [Parameter]
    public bool IsSubmitting { get; set; }

    [Parameter]
    public string? FormId { get; set; }

    [Parameter]
    public string? SubmitError { get; set; }

    [Parameter]
    public string Class { get; set; } = "";
}
