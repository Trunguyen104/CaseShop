@page "/checkout"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using CaseShop.Web.Components.Pages.Checkout.Components
@inject IProductService ProductService
@inject IOrderService OrderService
@inject ICartService CartService
@inject NavigationManager NavigationManager
@inject ILogger<Checkout> Logger

<PageTitle>Thanh toán — CaseShop</PageTitle>
@if (_isLoading)
{
    <div class="flex min-h-[55vh] flex-col items-center justify-center gap-4"><AppSpinner Size="AppSpinner.SpinnerSize.Large" /><p class="text-on-surface-variant">Đang chuẩn bị đơn hàng...</p></div>
}
else if (_loadError is not null)
{
    <AppEmptyState Icon="error_outline" Title="Không thể tiếp tục" Description="@_loadError" ButtonText="Quay lại cửa hàng" ButtonLink="/shop" Class="mx-auto my-16 max-w-lg" />
}
else if (_cartItems.Count == 0)
{
    <AppEmptyState Icon="shopping_cart" Title="Giỏ hàng đang trống" Description="Hãy thêm sản phẩm trước khi thanh toán." ButtonText="Khám phá sản phẩm" ButtonLink="/shop" Class="mx-auto my-16 max-w-lg" />
}
else
{
    <header class="border-b border-outline-variant bg-surface-container-lowest"><div class="mx-auto flex max-w-7xl items-center justify-between px-margin-mobile py-4 lg:px-margin"><div><p class="font-overline text-overline uppercase tracking-widest text-on-surface-variant">Checkout bảo mật</p><h1 class="font-headline-md text-headline-md font-semibold">Hoàn tất đơn hàng</h1></div><span class="hidden items-center gap-2 text-on-surface-variant sm:flex"><span class="material-symbols-outlined text-[18px]">lock</span>Bảo mật SSL</span></div></header>
    <main class="mx-auto w-full max-w-7xl px-margin-mobile py-6 lg:px-margin lg:py-10">
        <EditForm id="checkout-form" Model="_checkoutModel" OnValidSubmit="HandlePlaceOrderAsync" OnInvalidSubmit="HandleInvalidSubmit" FormName="checkout-form">
            <DataAnnotationsValidator />
            <div class="flex flex-col items-start gap-6 lg:flex-row lg:gap-10">
                <div class="flex w-full flex-col gap-6 lg:w-[62%]">
                    <section class="rounded-xl bg-surface-container-lowest p-5 shadow-sm sm:p-8">
                        <h2 class="mb-5 font-headline-sm text-headline-sm font-semibold">Người nhận thông báo</h2>
                        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                            <div class="space-y-1.5"><label for="customer-name" class="font-label-md text-label-md font-medium">Họ và tên <span class="text-error">*</span></label><InputText id="customer-name" @bind-Value="_checkoutModel.CustomerName" @bind-Value:after="ClearSubmitError" disabled="@_isSubmitting" autocomplete="name" class="h-11 w-full rounded-lg bg-surface-container-low px-3.5 outline-none focus:ring-2 focus:ring-primary/20" /><ValidationMessage For="@(() => _checkoutModel.CustomerName)" class="text-error" /></div>
                            <div class="space-y-1.5"><label for="customer-phone" class="font-label-md text-label-md font-medium">Số điện thoại <span class="text-error">*</span></label><InputText id="customer-phone" @bind-Value="_checkoutModel.Phone" @bind-Value:after="ClearSubmitError" disabled="@_isSubmitting" autocomplete="tel" class="h-11 w-full rounded-lg bg-surface-container-low px-3.5 outline-none focus:ring-2 focus:ring-primary/20" /><ValidationMessage For="@(() => _checkoutModel.Phone)" class="text-error" /></div>
                            <div class="space-y-1.5 sm:col-span-2"><label for="customer-email" class="font-label-md text-label-md font-medium">Email nhận xác nhận và vận đơn <span class="text-error">*</span></label><InputText id="customer-email" @bind-Value="_checkoutModel.Email" @bind-Value:after="ClearSubmitError" disabled="@_isSubmitting" type="email" autocomplete="email" class="h-11 w-full rounded-lg bg-surface-container-low px-3.5 outline-none focus:ring-2 focus:ring-primary/20" /><ValidationMessage For="@(() => _checkoutModel.Email)" class="text-error" /><p class="text-body-sm text-body-sm text-on-surface-variant">Email chỉ được dùng để gửi xác nhận và cập nhật đơn hàng.</p></div>
                        </div>
                    </section>
                    <DeliveryAddressSection IsDisabled="_isSubmitting" OnChanged="HandleAddressChanged" />
                    <PaymentMethodSection Value="_checkoutModel.PaymentMethod" ValueChanged="HandlePaymentMethodChangedAsync" IsDisabled="_isSubmitting" />
                    <CheckoutTrustBadges />
                </div>
                <aside class="w-full lg:sticky lg:top-20 lg:w-[38%]"><CheckoutOrderSummary CartItems="_cartItems" TotalQuantity="TotalQuantity" Subtotal="Subtotal" IsSubmitting="_isSubmitting" IsSubmitDisabled="@(!IsCheckoutReady)" FormId="checkout-form" SubmitError="@_submitError" /></aside>
            </div>
        </EditForm>
    </main>
}

@code {
    [SupplyParameterFromQuery(Name = "productId")] public string? ProductIdParam { get; set; }
    [SupplyParameterFromQuery(Name = "hasDesign")] public string? HasDesignParam { get; set; }
    [SupplyParameterFromQuery(Name = "previewUrl")] public string? PreviewUrlParam { get; set; }
    [SupplyParameterFromQuery(Name = "designData")] public string? DesignDataParam { get; set; }
    [SupplyParameterFromQuery(Name = "variant")] public string? VariantParam { get; set; }
    private List<ClientCartItem> _cartItems = [];
    private readonly CheckoutDto _checkoutModel = new() { PaymentMethod = PaymentMethodType.PayOSQr };
    private bool _isLoading = true, _isSubmitting, _initialized, _checkoutFromCart, _clearCartRequested;
    private string? _loadError, _submitError;
    private string? _pendingNavigationUrl;
    private int TotalQuantity => _cartItems.Sum(x => x.Quantity);
    private decimal Subtotal => _cartItems.Sum(x => x.UnitPrice * x.Quantity);
    private bool IsCheckoutReady => Validator.TryValidateObject(
        _checkoutModel,
        new ValidationContext(_checkoutModel),
        validationResults: null,
        validateAllProperties: true);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            try
            {
                if (Guid.TryParse(ProductIdParam, out var productId))
                {
                    var product = await ProductService.GetProductByIdAsync(productId);
                    if (product is not null && product.IsActive) _cartItems.Add(new() { ProductId = product.Id, ProductName = product.Name, ImageUrl = product.ImageUrl, UnitPrice = product.Price, Variant = VariantParam, CustomDesign = HasDesignParam == "1" && !string.IsNullOrWhiteSpace(PreviewUrlParam) && !string.IsNullOrWhiteSpace(DesignDataParam) ? new() { PreviewImageUrl = PreviewUrlParam, DesignData = DesignDataParam } : null });
                }
                else { _cartItems = (await CartService.GetItemsAsync()).ToList(); _checkoutFromCart = true; }
                _checkoutModel.Items = BuildItems();
            }
            catch { _loadError = "Không thể tải giỏ hàng. Vui lòng thử lại."; }
            finally { _isLoading = false; StateHasChanged(); }
        }

        if (_clearCartRequested && _pendingNavigationUrl is not null)
        {
            _clearCartRequested = false;
            await CartService.ClearAsync();
            NavigationManager.NavigateTo(_pendingNavigationUrl);
        }
    }

    private void HandleAddressChanged(DeliveryAddressSelection value)
    {
        ClearSubmitError();
        _checkoutModel.ProvinceCode = value.ProvinceCode; _checkoutModel.ProvinceName = value.ProvinceName; _checkoutModel.WardCode = value.WardCode; _checkoutModel.WardName = value.WardName;
        _checkoutModel.AddressLine = value.AddressLine;
    }
    private Task HandlePaymentMethodChangedAsync(PaymentMethodType value)
    {
        _checkoutModel.PaymentMethod = value;
        ClearSubmitError();
        return Task.CompletedTask;
    }
    private async Task HandlePlaceOrderAsync()
    {
        if (_isSubmitting) return; _isSubmitting = true; _submitError = null;
        try
        {
            _checkoutModel.Items = BuildItems();
            var result = await OrderService.CreateOrderAsync(_checkoutModel);
            if (result.PaymentMethod == PaymentMethodType.PayOSQr)
            {
                var clearCartQuery = _checkoutFromCart ? "?clearCart=true" : string.Empty;
                NavigationManager.NavigateTo($"/checkout/payment/{result.OrderCode}{clearCartQuery}");
                return;
            }

            _pendingNavigationUrl = $"/checkout/success/{result.OrderCode}";
            _clearCartRequested = _checkoutFromCart;
            if (_clearCartRequested) StateHasChanged();
            else NavigationManager.NavigateTo(_pendingNavigationUrl);
        }
        catch (ArgumentException ex) { _submitError = ex.Message; }
        catch (InvalidOperationException ex) { _submitError = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "Unexpected checkout submission failure."); _submitError = "Không thể tạo đơn hàng lúc này. Vui lòng thử lại."; }
        finally { _isSubmitting = false; }
    }
    private void HandleInvalidSubmit() => _submitError = "Vui lòng kiểm tra các trường bắt buộc và định dạng email.";
    private void ClearSubmitError() => _submitError = null;
    private List<CheckoutItemDto> BuildItems() => _cartItems.Select(x => new CheckoutItemDto { ProductId = x.ProductId, Quantity = x.Quantity, Variant = x.Variant, CustomDesign = x.CustomDesign }).ToList();
}
