@page "/checkout/success/{OrderCode}"
@rendermode InteractiveServer
@using CaseShop.Web.DTOs
@using CaseShop.Web.Entities
@using CaseShop.Web.Services
@inject IOrderService OrderService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Đặt hàng thành công — CaseShop</PageTitle>

<div class="flex flex-col w-full">

    @if (_isLoading)
    {
        <!-- Loading State -->
        <div class="w-full max-w-7xl mx-auto px-margin-mobile lg:px-margin py-24 flex flex-col items-center justify-center gap-4">
            <AppSpinner Size="AppSpinner.SpinnerSize.Large" />
            <p class="font-body-md text-body-md text-on-surface-variant">Đang tải thông tin đơn hàng...</p>
        </div>
    }
    else if (_order is null)
    {
        <!-- Order Not Found State -->
        <div class="w-full max-w-7xl mx-auto px-margin-mobile lg:px-margin py-16">
            <div class="max-w-md mx-auto bg-surface-container-lowest rounded-xl p-8 shadow-sm flex flex-col items-center gap-4 text-center">
                <span class="material-symbols-outlined text-[48px] text-on-surface-variant">search_off</span>
                <h1 class="font-headline-sm text-headline-sm text-on-surface">Không tìm thấy đơn hàng</h1>
                <p class="font-body-md text-body-md text-on-surface-variant">
                    Đơn hàng với mã "<strong>@OrderCode</strong>" không tồn tại hoặc đã bị xóa.
                </p>
                <a href="/" class="inline-flex items-center justify-center px-6 py-2.5 rounded-lg bg-primary text-on-primary font-label-md text-label-md hover:bg-neutral-800 transition-all">
                    Về trang chủ
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Success Page Content -->
        <div class="relative w-full py-12 lg:py-20 px-margin-mobile lg:px-margin flex items-start justify-center">
            <!-- Ambient gradient decoration -->
            <div class="absolute inset-0 pointer-events-none flex items-center justify-center overflow-hidden">
                <div class="w-[720px] h-[520px] bg-gradient-to-b from-secondary-container/20 to-transparent blur-3xl rounded-full -translate-y-12"></div>
            </div>

            <!-- Main Card -->
            <div class="relative w-full max-w-[680px] bg-surface-container-lowest rounded-xl shadow-xl shadow-on-surface/5 p-6 sm:p-10 lg:p-12 space-y-8">

                <!-- Success Hero -->
                <div class="flex flex-col items-center text-center space-y-4">
                    <div class="relative flex items-center justify-center">
                        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-primary flex items-center justify-center shadow-lg shadow-primary/20">
                            <span class="material-symbols-outlined text-on-primary text-3xl sm:text-4xl" style="font-variation-settings: 'FILL' 1;">check</span>
                        </div>
                        <div class="absolute -top-1 -right-1 w-5 h-5 bg-surface-container-lowest rounded-full flex items-center justify-center">
                            <span class="w-3 h-3 bg-surface-tint rounded-full animate-ping opacity-75"></span>
                        </div>
                    </div>
                    <div class="space-y-2">
                        <span class="font-overline text-overline uppercase text-on-surface-variant tracking-widest">Đơn hàng đã được xác nhận</span>
                        <h1 class="font-headline-xl text-headline-xl-mobile sm:text-headline-xl text-on-surface font-semibold tracking-tight">Đặt hàng thành công!</h1>
                        <p class="font-body-md text-body-md text-on-surface-variant max-w-lg mx-auto leading-relaxed">
                            Cảm ơn bạn đã tin chọn CASESHOP. Đơn hàng của bạn đã được ghi nhận và đang được chuẩn bị gia công theo yêu cầu.
                        </p>
                    </div>
                </div>

                <!-- Order Meta Block -->
                <div class="w-full bg-surface-container-low rounded-lg p-5 sm:p-6 space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-outline-variant">
                        <div class="space-y-1">
                            <span class="font-label-sm text-label-sm uppercase text-on-surface-variant font-medium">Mã đơn hàng</span>
                            <div class="flex items-center gap-2">
                                <span class="font-headline-sm text-headline-sm text-on-surface font-semibold tracking-wide" id="order-code">#@_order.OrderCode</span>
                                <button class="p-1.5 rounded-lg bg-surface-container hover:bg-surface-container-high transition-colors text-on-surface flex items-center justify-center"
                                        @onclick="CopyOrderCode"
                                        title="Sao chép mã đơn hàng">
                                    <span class="material-symbols-outlined text-sm">@(_isCopied ? "check" : "content_copy")</span>
                                </button>
                            </div>
                        </div>
                        <div class="sm:text-right space-y-1">
                            <span class="font-label-sm text-label-sm uppercase text-on-surface-variant font-medium">Thời gian đặt hàng</span>
                            <p class="font-body-md text-body-md text-on-surface font-medium">@_order.CreatedAt.ToString("dd/MM/yyyy — HH:mm")</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="flex items-start gap-3 bg-surface-container-lowest p-3.5 rounded-lg shadow-sm">
                            <div class="w-8 h-8 rounded bg-surface-container flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-on-surface text-[18px]">payments</span>
                            </div>
                            <div>
                                <p class="font-label-sm text-label-sm text-on-surface-variant font-medium">Hình thức thanh toán</p>
                                <p class="font-body-sm text-body-sm text-on-surface font-semibold">
                                    @(_order.PaymentMethod == PaymentMethodType.CashOnDelivery
                                        ? "COD (Nhận hàng thanh toán)"
                                        : "Chuyển khoản ngân hàng")
                                </p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3 bg-surface-container-lowest p-3.5 rounded-lg shadow-sm">
                            <div class="w-8 h-8 rounded bg-surface-container flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-on-surface text-[18px]">local_shipping</span>
                            </div>
                            <div>
                                <p class="font-label-sm text-label-sm text-on-surface-variant font-medium">Giao hàng dự kiến</p>
                                <p class="font-body-sm text-body-sm text-on-surface font-semibold">2 – 3 ngày làm việc</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Product Details -->
                <div class="space-y-4">
                    <div class="flex items-center justify-between">
                        <h2 class="font-label-md text-label-md uppercase tracking-wider text-on-surface font-semibold">Chi tiết sản phẩm</h2>
                        <span class="font-label-sm text-label-sm text-on-surface-variant">@_order.Items.Count món trong đơn</span>
                    </div>

                    @foreach (var item in _order.Items)
                    {
                        <div class="bg-surface-container-low rounded-lg p-4 sm:p-5 flex items-center gap-4">
                            <!-- Product Image -->
                            <div class="w-20 h-24 rounded-lg bg-surface-container-high overflow-hidden shrink-0 flex items-center justify-center">
                                @if (!string.IsNullOrEmpty(item.ProductImageUrl))
                                {
                                    <img class="w-full h-full object-contain mix-blend-multiply"
                                         src="@item.ProductImageUrl"
                                         alt="@item.ProductName" />
                                }
                                else
                                {
                                    <span class="material-symbols-outlined text-[28px] text-on-surface-variant">image</span>
                                }
                            </div>

                            <!-- Product Info -->
                            <div class="flex-1 min-w-0 flex flex-col justify-between py-0.5 gap-2">
                                <div class="space-y-1">
                                    <div class="flex items-baseline justify-between gap-2">
                                        <h3 class="font-label-md text-label-md text-on-surface font-semibold line-clamp-2">@item.ProductName</h3>
                                        <span class="font-label-md text-label-md text-on-surface font-bold shrink-0">@item.LineTotal.ToString("N0")₫</span>
                                    </div>
                                    @if (item.CustomDesign is not null)
                                    {
                                        <div class="inline-flex items-center gap-1.5 px-2 py-0.5 bg-surface-container rounded font-label-sm text-label-sm text-on-surface">
                                            <span class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></span>
                                            Có thiết kế tùy chỉnh
                                        </div>
                                    }
                                </div>
                                <div class="flex items-center justify-between">
                                    <span class="font-label-sm text-label-sm text-on-surface-variant">Số lượng: @item.Quantity</span>
                                    <span class="font-body-sm text-body-sm text-on-surface-variant">@item.UnitPrice.ToString("N0")₫ / cái</span>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Price Breakdown -->
                    <div class="space-y-2 pt-1 px-1">
                        <div class="flex items-center justify-between font-body-sm text-body-sm text-on-surface-variant">
                            <span>Tạm tính</span>
                            <span class="text-on-surface font-medium">@_order.TotalAmount.ToString("N0")₫</span>
                        </div>
                        <div class="flex items-center justify-between font-body-sm text-body-sm text-on-surface-variant">
                            <span>Phí giao hàng</span>
                            <span class="text-on-surface font-medium">Miễn phí</span>
                        </div>
                        <div class="flex items-center justify-between pt-3 border-t border-outline-variant font-headline-sm text-headline-sm text-on-surface font-semibold">
                            <span>Tổng thanh toán</span>
                            <span class="font-bold">@_order.TotalAmount.ToString("N0")₫</span>
                        </div>
                    </div>
                </div>

                <!-- Email Confirmation Notice -->
                <div class="w-full bg-surface-container-low rounded-lg p-4 flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary text-[20px] mt-0.5 shrink-0">mail</span>
                    <div class="space-y-0.5">
                        <p class="font-label-md text-label-md text-on-surface font-semibold">Xác nhận đơn qua email</p>
                        <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                            Chúng tôi đã gửi email xác nhận đến <strong>@_order.Email</strong>. Vui lòng kiểm tra mục Thư đến hoặc Spam.
                        </p>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3">
                    <a href="/track?orderCode=@_order.OrderCode"
                       class="h-11 sm:h-12 px-6 rounded-lg bg-primary hover:bg-neutral-800 text-on-primary font-label-md text-label-md font-semibold flex items-center justify-center gap-2 shadow-md hover:shadow-lg transition-all">
                        <span class="material-symbols-outlined text-[18px]">travel_explore</span>
                        Theo dõi đơn hàng
                    </a>
                    <a href="/shop"
                       class="h-11 sm:h-12 px-6 rounded-lg bg-surface-container-lowest hover:bg-surface-container text-on-surface font-label-md text-label-md font-semibold flex items-center justify-center gap-2 transition-colors shadow-sm border border-outline-variant">
                        <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                        Tiếp tục mua sắm
                    </a>
                </div>

                <!-- Trust Footer -->
                <div class="flex flex-wrap items-center justify-center gap-6 text-on-surface-variant font-label-sm text-label-sm">
                    <div class="flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[16px]">verified</span>
                        Bảo hành chính hãng 12 tháng
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[16px]">published_with_changes</span>
                        Đổi trả trong 30 ngày
                    </div>
                </div>

            </div>
        </div>

        <!-- Copy Toast -->
        @if (_showCopyToast)
        {
            <div class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-inverse-surface text-inverse-on-surface px-4 py-2 rounded-lg font-body-sm text-body-sm shadow-xl flex items-center gap-2 z-50 transition-all">
                <span class="material-symbols-outlined text-[16px]">check_circle</span>
                <span>Đã sao chép mã đơn hàng!</span>
            </div>
        }
    }

</div>

@code {
    [Parameter]
    public string? OrderCode { get; set; }

    private OrderDetailDto? _order;
    private bool _isLoading = true;
    private bool _isCopied = false;
    private bool _showCopyToast = false;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            if (!string.IsNullOrWhiteSpace(OrderCode))
            {
                _order = await OrderService.GetOrderByCodeAsync(OrderCode.Trim().ToUpperInvariant());
            }
        }
        catch
        {
            _order = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CopyOrderCode()
    {
        if (_order is null) return;

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _order.OrderCode);
            _isCopied = true;
            _showCopyToast = true;
            StateHasChanged();

            await Task.Delay(2400);

            _isCopied = false;
            _showCopyToast = false;
            StateHasChanged();
        }
        catch
        {
            // Clipboard API may be unavailable in some contexts — silently ignore
        }
    }
}
