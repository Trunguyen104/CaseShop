@page "/stickers"
@using CaseShop.Web.DTOs
@using CaseShop.Web.Services
@inject IStickerService StickerService

<PageTitle>Stickers - CaseShop</PageTitle>

<div class="container mt-4">
    <h1 class="mb-4">Stickers</h1>

    @if (stickers == null)
    {
        <p><em>Loading stickers...</em></p>
    }
    else if (!stickers.Any())
    {
        <p>No stickers available at the moment.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var sticker in stickers)
            {
                <div class="col">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(sticker.ImageUrl))
                        {
                            <img src="@sticker.ImageUrl" class="card-img-top" alt="@sticker.Name" style="object-fit: cover; height: 200px;">
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center text-muted" style="height: 200px;">
                                <span>No Image</span>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@sticker.Name</h5>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private IReadOnlyList<StickerDto>? stickers;

    protected override async Task OnInitializedAsync()
    {
        stickers = await StickerService.GetActiveStickersAsync();
    }
}
