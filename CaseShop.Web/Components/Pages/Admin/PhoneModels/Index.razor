@page "/admin/phone-models"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@inject IPhoneCatalogService CatalogService
@inject IJSRuntime JS

<PageTitle>Quản lý dòng điện thoại - CaseShop</PageTitle>
<AdminShell ActiveSection="phone-models">
    <AdminPageHeader Title="Dòng điện thoại" Subtitle="Dữ liệu thiết bị">
        <a href="/admin/phone-models/create" class="btn btn-primary">
            <span class="material-symbols-outlined text-[18px]">add</span>
            <span>Thêm dòng máy</span>
        </a>
    </AdminPageHeader>

    @if (_loading)
    {
        <div class="alert alert-info" role="status">Đang tải danh sách dòng máy...</div>
    }
    else if (_error)
    {
        <div class="alert alert-danger" role="alert">
            Không thể tải danh sách. <button class="font-semibold underline" @onclick="LoadAsync">Thử lại</button>
        </div>
    }
    else if (_items.Count == 0)
    {
        <AppEmptyState Icon="smartphone"
                       Title="Chưa có dòng điện thoại"
                       Description="Tạo thương hiệu trước, sau đó thêm dòng điện thoại."
                       ButtonText="Thêm dòng máy"
                       ButtonLink="/admin/phone-models/create"
                       ButtonIcon="add" />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Thương hiệu</th>
                        <th>Dòng máy</th>
                        <th>Slug</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr>
                            <td>@item.PhoneBrandName</td>
                            <td class="font-semibold">@item.Name</td>
                            <td><code>@item.Slug</code></td>
                            <td><AdminStatusBadge IsActive="item.IsActive" /></td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a class="btn btn-sm btn-outline-primary" href="/admin/phone-models/edit/@item.Id">Sửa</a>
                                    @if (item.IsActive)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeactivateAsync(item)">Ngừng hoạt động</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</AdminShell>

@code {
    private IReadOnlyList<PhoneModelDto> _items=[]; private bool _loading=true,_error;
    protected override Task OnInitializedAsync()=>LoadAsync();
    private async Task LoadAsync(){_loading=true;_error=false;try{_items=await CatalogService.GetPhoneModelsAsync(activeOnly:false);}catch{_error=true;}finally{_loading=false;}}
    private async Task DeactivateAsync(PhoneModelDto item){if(!await JS.InvokeAsync<bool>("confirm",$"Ngừng dòng máy “{item.Name}”?"))return;try{await CatalogService.DeactivatePhoneModelAsync(item.Id);await LoadAsync();}catch{_error=true;}}
}
