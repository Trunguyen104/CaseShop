@page "/admin/phone-models/create"
@page "/admin/phone-models/edit/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@inject IPhoneCatalogService CatalogService
@inject NavigationManager Navigation

<PageTitle>@(IsEdit ? "Sửa" : "Thêm") dòng điện thoại - CaseShop</PageTitle>
<AdminShell ActiveSection="phone-models">
    <AdminPageHeader Title="@(IsEdit ? "Chỉnh sửa dòng điện thoại" : "Thêm dòng điện thoại")" Subtitle="Dữ liệu thiết bị" />

    @if(_loading)
    {
        <div class="alert alert-info">Đang tải dữ liệu...</div>
    }
    else if(_notFound)
    {
        <div class="alert alert-warning">
            <p class="mb-0">Không tìm thấy dòng điện thoại.</p>
            <a class="btn btn-secondary mt-3" href="/admin/phone-models">Về danh sách</a>
        </div>
    }
    else if(!IsEdit && _brands.Count == 0)
    {
        <div class="alert alert-warning">
            <p class="mb-0">Cần ít nhất một thương hiệu đang hoạt động trước khi tạo dòng máy.</p>
            <a class="btn btn-primary mt-3" href="/admin/phone-brands/create">Thêm thương hiệu</a>
        </div>
    }
    else
    {
        <div class="w-full">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                <!-- Cột trái: Form nhập liệu (50% trên Desktop) -->
                <div class="lg:col-span-6 space-y-6">
                    @if(_error is not null)
                    {
                        <div class="alert alert-danger" role="alert">@_error</div>
                    }

                    <EditForm Model="_model" OnValidSubmit="SubmitAsync" FormName="phoneModelForm">
                        <DataAnnotationsValidator/>
                        <ValidationSummary class="mb-4 text-danger"/>
                        
                        <!-- 1. Thông tin cơ bản -->
                        <div class="card shadow-sm border-0 mb-6 bg-surface-container-lowest">
                            <div class="card-header bg-surface-container-low/70 border-bottom py-3 px-4 flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary text-[20px]">badge</span>
                                    <h5 class="font-semibold text-sm mb-0">1. Thông tin cơ bản</h5>
                                </div>
                            </div>
                            <div class="card-body p-4 space-y-4">
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <div>
                                        <label class="form-label font-semibold" for="model-brand">Thương hiệu <span class="text-danger">*</span></label>
                                        <InputSelect id="model-brand" class="form-select" @bind-Value="_model.PhoneBrandId">
                                            <option value="@Guid.Empty">-- Chọn thương hiệu --</option>
                                            @foreach(var brand in _brands)
                                            {
                                                <option value="@brand.Id">@brand.Name@(!brand.IsActive ? " (đã ngừng)" : "")</option>
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="@(()=>_model.PhoneBrandId)" class="text-danger"/>
                                    </div>
                                    <div>
                                        <label class="form-label font-semibold" for="model-name">Tên dòng máy <span class="text-danger">*</span></label>
                                        <InputText id="model-name" class="form-control" placeholder="Ví dụ: iPhone 16 Pro" @bind-Value="_model.Name"/>
                                        <ValidationMessage For="@(()=>_model.Name)" class="text-danger"/>
                                    </div>
                                </div>
                                <div>
                                    <label class="form-label font-semibold" for="model-slug">Slug (Đường dẫn tĩnh)</label>
                                    <InputText id="model-slug" class="form-control" placeholder="Ví dụ: iphone-16-pro" @bind-Value="_model.Slug"/>
                                    <small class="text-muted block mt-1">Slug dùng cho URL định danh, duy nhất trong cùng thương hiệu.</small>
                                    <ValidationMessage For="@(()=>_model.Slug)" class="text-danger"/>
                                </div>
                                <div class="form-check pt-1">
                                    <InputCheckbox id="model-active" class="form-check-input" @bind-Value="_model.IsActive"/>
                                    <label class="form-check-label font-medium" for="model-active">Đang kích hoạt (Cho phép hiển thị và đặt hàng)</label>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Khung in & Bo góc (Canvas) -->
                        <div class="card shadow-sm border-0 mb-6 bg-surface-container-lowest">
                            <div class="card-header bg-surface-container-low/70 border-bottom py-3 px-4 flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary text-[20px]">aspect_ratio</span>
                                    <h5 class="font-semibold text-sm mb-0">2. Khung in Canvas &amp; Bo góc</h5>
                                </div>
                                <span class="text-xs text-muted">Đơn vị: mm</span>
                            </div>
                            <div class="card-body p-4">
                                <div class="grid grid-cols-3 gap-3">
                                    <div>
                                        <label class="form-label font-semibold text-xs sm:text-sm">Width (mm)</label>
                                        <InputNumber class="form-control font-mono" @bind-Value="_model.CanvasWidth"/>
                                        <ValidationMessage For="@(()=>_model.CanvasWidth)" class="text-danger"/>
                                    </div>
                                    <div>
                                        <label class="form-label font-semibold text-xs sm:text-sm">Height (mm)</label>
                                        <InputNumber class="form-control font-mono" @bind-Value="_model.CanvasHeight"/>
                                        <ValidationMessage For="@(()=>_model.CanvasHeight)" class="text-danger"/>
                                    </div>
                                    <div>
                                        <label class="form-label font-semibold text-xs sm:text-sm">Corner Radius (mm)</label>
                                        <InputNumber class="form-control font-mono" @bind-Value="_model.CornerRadius"/>
                                        <ValidationMessage For="@(()=>_model.CornerRadius)" class="text-danger"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 3. Cụm Camera Cutout -->
                        <div class="card shadow-sm border-0 mb-6 bg-surface-container-lowest">
                            <div class="card-header bg-surface-container-low/70 border-bottom py-3 px-4 flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary text-[20px]">photo_camera</span>
                                    <h5 class="font-semibold text-sm mb-0">3. Cụm Camera Cutout (4 cạnh bo góc)</h5>
                                </div>
                                <span class="text-xs text-muted">Đơn vị: mm</span>
                            </div>
                            <div class="card-body p-4 space-y-4">
                                <div class="grid grid-cols-3 gap-3">
                                    <div>
                                        <label class="form-label font-semibold text-xs sm:text-sm">X (mm)</label>
                                        <InputNumber class="form-control font-mono" @bind-Value="_model.CameraCutoutX"/>
                                        <ValidationMessage For="@(()=>_model.CameraCutoutX)" class="text-danger"/>
                                    </div>
                                    <div>
                                        <label class="form-label font-semibold text-xs sm:text-sm">Y (mm)</label>
                                        <InputNumber class="form-control font-mono" @bind-Value="_model.CameraCutoutY"/>
                                        <ValidationMessage For="@(()=>_model.CameraCutoutY)" class="text-danger"/>
                                    </div>
                                    <div>
                                        <label class="form-label font-semibold text-xs sm:text-sm">Bo góc cam (mm)</label>
                                        <InputNumber class="form-control font-mono" @bind-Value="_model.CameraCutoutRadius"/>
                                        <ValidationMessage For="@(()=>_model.CameraCutoutRadius)" class="text-danger"/>
                                    </div>
                                </div>
                                <div class="grid grid-cols-2 gap-3">
                                    <div>
                                        <label class="form-label font-semibold text-xs sm:text-sm">Width (mm)</label>
                                        <InputNumber class="form-control font-mono" @bind-Value="_model.CameraCutoutWidth"/>
                                        <ValidationMessage For="@(()=>_model.CameraCutoutWidth)" class="text-danger"/>
                                    </div>
                                    <div>
                                        <label class="form-label font-semibold text-xs sm:text-sm">Height (mm)</label>
                                        <InputNumber class="form-control font-mono" @bind-Value="_model.CameraCutoutHeight"/>
                                        <ValidationMessage For="@(()=>_model.CameraCutoutHeight)" class="text-danger"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 4. Vùng in & Vùng an toàn & Tràn lề -->
                        <div class="card shadow-sm border-0 mb-6 bg-surface-container-lowest">
                            <div class="card-header bg-surface-container-low/70 border-bottom py-3 px-4 flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary text-[20px]">layers</span>
                                    <h5 class="font-semibold text-sm mb-0">4. Vùng in &amp; Vùng an toàn</h5>
                                </div>
                                <span class="text-xs text-muted">Đơn vị: mm</span>
                            </div>
                            <div class="card-body p-4 space-y-4">
                                <div class="border-b border-outline-variant/40 pb-3">
                                    <div class="text-xs font-semibold text-amber-500 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                                        <span class="w-2.5 h-2.5 rounded-sm bg-amber-500"></span>
                                        Vùng in (Print Area)
                                    </div>
                                    <div class="grid grid-cols-4 gap-2">
                                        <div>
                                            <label class="form-label text-xs">X</label>
                                            <InputNumber class="form-control font-mono" @bind-Value="_model.PrintAreaX"/>
                                        </div>
                                        <div>
                                            <label class="form-label text-xs">Y</label>
                                            <InputNumber class="form-control font-mono" @bind-Value="_model.PrintAreaY"/>
                                        </div>
                                        <div>
                                            <label class="form-label text-xs">Width</label>
                                            <InputNumber class="form-control font-mono" @bind-Value="_model.PrintAreaWidth"/>
                                        </div>
                                        <div>
                                            <label class="form-label text-xs">Height</label>
                                            <InputNumber class="form-control font-mono" @bind-Value="_model.PrintAreaHeight"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="border-b border-outline-variant/40 pb-3">
                                    <div class="text-xs font-semibold text-blue-500 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                                        <span class="w-2.5 h-2.5 rounded-sm bg-blue-500"></span>
                                        Vùng an toàn (Safe Area)
                                    </div>
                                    <div class="grid grid-cols-4 gap-2">
                                        <div>
                                            <label class="form-label text-xs">X</label>
                                            <InputNumber class="form-control font-mono" @bind-Value="_model.SafeAreaX"/>
                                        </div>
                                        <div>
                                            <label class="form-label text-xs">Y</label>
                                            <InputNumber class="form-control font-mono" @bind-Value="_model.SafeAreaY"/>
                                        </div>
                                        <div>
                                            <label class="form-label text-xs">Width</label>
                                            <InputNumber class="form-control font-mono" @bind-Value="_model.SafeAreaWidth"/>
                                        </div>
                                        <div>
                                            <label class="form-label text-xs">Height</label>
                                            <InputNumber class="form-control font-mono" @bind-Value="_model.SafeAreaHeight"/>
                                        </div>
                                    </div>
                                </div>

                                <div>
                                    <div class="text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-2">Tràn lề (Bleed)</div>
                                    <div class="grid grid-cols-4 gap-2">
                                        <div>
                                            <label class="form-label text-xs">Top</label>
                                            <InputNumber class="form-control font-mono" @bind-Value="_model.BleedTop"/>
                                        </div>
                                        <div>
                                            <label class="form-label text-xs">Right</label>
                                            <InputNumber class="form-control font-mono" @bind-Value="_model.BleedRight"/>
                                        </div>
                                        <div>
                                            <label class="form-label text-xs">Bottom</label>
                                            <InputNumber class="form-control font-mono" @bind-Value="_model.BleedBottom"/>
                                        </div>
                                        <div>
                                            <label class="form-label text-xs">Left</label>
                                            <InputNumber class="form-control font-mono" @bind-Value="_model.BleedLeft"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 5. Hình ảnh tài nguyên (Tùy chọn) -->
                        <div class="card shadow-sm border-0 mb-6 bg-surface-container-lowest">
                            <div class="card-header bg-surface-container-low/70 border-bottom py-3 px-4 flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary text-[20px]">image</span>
                                    <h5 class="font-semibold text-sm mb-0">5. Hình ảnh tài nguyên (Tùy chọn)</h5>
                                </div>
                            </div>
                            <div class="card-body p-4 space-y-4">
                                <div>
                                    <label class="form-label font-semibold">Mask Image URL (Ảnh che camera tùy chọn)</label>
                                    <InputText class="form-control" placeholder="https://..." @bind-Value="_model.MaskImageUrl"/>
                                    <small class="text-muted block mt-1">Nếu để trống, hệ thống sẽ tự động dùng toạ độ cụm camera 4 cạnh ở trên.</small>
                                    <ValidationMessage For="@(()=>_model.MaskImageUrl)" class="text-danger"/>
                                </div>
                                <div>
                                    <label class="form-label font-semibold">Overlay Image URL (Ảnh phủ bóng/viền)</label>
                                    <InputText class="form-control" placeholder="https://..." @bind-Value="_model.OverlayImageUrl"/>
                                    <ValidationMessage For="@(()=>_model.OverlayImageUrl)" class="text-danger"/>
                                </div>
                            </div>
                        </div>

                        <!-- Nút hành động -->
                        <div class="flex items-center justify-end gap-3 pt-2 pb-8">
                            <a class="btn btn-secondary px-6" href="/admin/phone-models">Hủy</a>
                            <button class="btn btn-primary px-8" type="submit" disabled="@_submitting">
                                @if (_submitting)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span>Đang lưu...</span>
                                }
                                else
                                {
                                    <span class="material-symbols-outlined text-[18px]">save</span>
                                    <span>Lưu dòng máy</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>

                <!-- Cột phải: Live Preview SVG (50% trên Desktop, Sticky theo màn hình) -->
                <div class="lg:col-span-6">
                    <div class="sticky top-20">
                        <PhoneModelPreview Model="_model" />
                    </div>
                </div>
            </div>
        </div>
    }
</AdminShell>

@code {
    [Parameter] public Guid? Id { get; set; } 
    private PhoneModelCreateUpdateDto _model = new(); 
    private IReadOnlyList<PhoneBrandDto> _brands = []; 
    private bool _loading = true, _notFound, _submitting;
    private string? _error;
    private bool IsEdit => Id.HasValue;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            PhoneModelDto? current = null;
            if (IsEdit)
            {
                current = await CatalogService.GetPhoneModelAsync(Id!.Value);
                if (current is null) { _notFound = true; return; }
                
                _model = new() 
                { 
                    PhoneBrandId = current.PhoneBrandId, 
                    Name = current.Name, 
                    Slug = current.Slug, 
                    IsActive = current.IsActive,
                    CanvasWidth = current.CanvasWidth,
                    CanvasHeight = current.CanvasHeight,
                    CornerRadius = current.CornerRadius,
                    SafeAreaX = current.SafeAreaX,
                    SafeAreaY = current.SafeAreaY,
                    SafeAreaWidth = current.SafeAreaWidth,
                    SafeAreaHeight = current.SafeAreaHeight,
                    PrintAreaX = current.PrintAreaX,
                    PrintAreaY = current.PrintAreaY,
                    PrintAreaWidth = current.PrintAreaWidth,
                    PrintAreaHeight = current.PrintAreaHeight,
                    BleedTop = current.BleedTop,
                    BleedRight = current.BleedRight,
                    BleedBottom = current.BleedBottom,
                    BleedLeft = current.BleedLeft,
                    CameraCutoutX = current.CameraCutoutX,
                    CameraCutoutY = current.CameraCutoutY,
                    CameraCutoutWidth = current.CameraCutoutWidth,
                    CameraCutoutHeight = current.CameraCutoutHeight,
                    CameraCutoutRadius = current.CameraCutoutRadius,
                    MaskImageUrl = current.MaskImageUrl,
                    OverlayImageUrl = current.OverlayImageUrl
                };
            }
            var all = await CatalogService.GetPhoneBrandsAsync(false);
            _brands = all.Where(x => x.IsActive || x.Id == current?.PhoneBrandId).ToList();
        }
        catch
        {
            _error = "Không thể tải dữ liệu dòng máy.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SubmitAsync()
    {
        if (_submitting) return;
        _submitting = true;
        _error = null;
        try
        {
            if (IsEdit) 
                await CatalogService.UpdatePhoneModelAsync(Id!.Value, _model);
            else 
                await CatalogService.CreatePhoneModelAsync(_model);
                
            Navigation.NavigateTo("/admin/phone-models");
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        catch (KeyNotFoundException)
        {
            _error = "Thương hiệu hoặc dòng máy không tồn tại.";
        }
        catch
        {
            _error = "Không thể lưu dòng máy. Vui lòng kiểm tra lại thông tin (kích thước, tọa độ, v.v.).";
        }
        finally
        {
            _submitting = false;
        }
    }
}
