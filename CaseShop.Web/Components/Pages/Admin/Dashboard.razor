@page "/admin"
@page "/admin/dashboard"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using CaseShop.Web.DTOs
@using CaseShop.Web.Entities
@using CaseShop.Web.Services
@inject IOrderService OrderService
@inject IProductService ProductService
@inject IStickerService StickerService

<PageTitle>Bảng điều khiển — CaseShop Admin</PageTitle>


    <AdminShell ActiveSection="dashboard">
    <div class="container py-4">
       

    <!-- MAIN CONTENT -->
    <section class="flex-1 flex flex-col gap-6 min-w-0">

        <!-- Top Action Bar -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-surface-container-lowest p-5 rounded-xl shadow-sm">
            <div>
                <div class="flex items-center gap-2">
                    <span class="font-overline text-overline uppercase tracking-wider text-on-surface-variant">Control Center</span>
                    <span class="font-overline text-overline text-outline-variant">•</span>
                    <span class="font-overline text-overline text-on-surface-variant">Thời gian thực</span>
                </div>
                <h1 class="font-headline-md text-headline-md text-on-surface font-bold mt-0.5">Bảng điều khiển quản trị</h1>
            </div>
            <div class="flex items-center gap-3 shrink-0 flex-wrap">
                <a href="/admin/orders"
                   class="flex items-center gap-2 bg-primary hover:bg-neutral-800 text-on-primary px-4 py-2 rounded-lg font-label-md text-label-md transition-all shadow-sm">
                    <span class="material-symbols-outlined text-[18px]">list_alt</span>
                    <span>Xem tất cả đơn hàng</span>
                </a>
            </div>
        </div>

        @if (_isLoading)
        {
            <!-- Loading State -->
            <div class="flex flex-col items-center justify-center py-16 gap-4">
                <AppSpinner />
                <p class="font-body-md text-body-md text-on-surface-variant">Đang tải dữ liệu...</p>
            </div>
        }
        else if (_hasLoadError)
        {
            <div class="bg-surface-container-lowest rounded-xl shadow-sm px-6 py-12 flex flex-col items-center text-center gap-3" role="alert">
                <span class="material-symbols-outlined text-[38px] text-error">cloud_off</span>
                <div>
                    <h2 class="font-headline-sm text-headline-sm font-semibold text-on-surface">Không thể tải dữ liệu quản trị</h2>
                    <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">Vui lòng kiểm tra kết nối dữ liệu và thử lại.</p>
                </div>
                <button type="button"
                        class="mt-2 inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-on-primary font-label-md text-label-md hover:bg-neutral-800 transition-colors"
                        @onclick="LoadDashboardAsync">
                    <span class="material-symbols-outlined text-[17px]">refresh</span>
                    Thử lại
                </button>
            </div>
        }
        else
        {
            <!-- KPI Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-4">
                <!-- Total Products -->
                <div class="bg-surface-container-lowest p-4 rounded-xl shadow-sm flex flex-col justify-between gap-3">
                    <div class="flex items-center justify-between">
                        <span class="font-overline text-overline uppercase text-on-surface-variant font-semibold">Tổng sản phẩm</span>
                        <span class="w-7 h-7 rounded-md bg-surface-container-low flex items-center justify-center text-on-surface">
                            <span class="material-symbols-outlined text-[16px]">grid_view</span>
                        </span>
                    </div>
                    <div>
                        <div class="font-headline-xl text-headline-xl font-bold tracking-tight text-on-surface">@_totalProducts</div>
                        <div class="flex items-center gap-1.5 mt-1 font-body-sm text-body-sm text-on-surface-variant">
                            <span class="truncate">sản phẩm trong hệ thống</span>
                        </div>
                    </div>
                </div>

                <!-- Total Stickers -->
                <div class="bg-surface-container-lowest p-4 rounded-xl shadow-sm flex flex-col justify-between gap-3">
                    <div class="flex items-center justify-between">
                        <span class="font-overline text-overline uppercase text-on-surface-variant font-semibold">Sticker</span>
                        <span class="w-7 h-7 rounded-md bg-surface-container-low flex items-center justify-center text-on-surface">
                            <span class="material-symbols-outlined text-[16px]">auto_awesome</span>
                        </span>
                    </div>
                    <div>
                        <div class="font-headline-xl text-headline-xl font-bold tracking-tight text-on-surface">@_totalStickers</div>
                        <div class="mt-1 font-body-sm text-body-sm text-on-surface-variant">@_activeStickers đang hoạt động</div>
                    </div>
                </div>

                <!-- Active Products -->
                <div class="bg-surface-container-lowest p-4 rounded-xl shadow-sm flex flex-col justify-between gap-3">
                    <div class="flex items-center justify-between">
                        <span class="font-overline text-overline uppercase text-on-surface-variant font-semibold">Đang bán</span>
                        <span class="w-7 h-7 rounded-md bg-surface-container-low flex items-center justify-center text-on-surface">
                            <span class="material-symbols-outlined text-[16px]">check_circle</span>
                        </span>
                    </div>
                    <div>
                        <div class="font-headline-xl text-headline-xl font-bold tracking-tight text-on-surface">@_activeProducts</div>
                        <div class="flex items-center gap-1.5 mt-1 font-body-sm text-body-sm text-on-surface-variant">
                            @if (_totalProducts > 0)
                            {
                                <span class="w-2 h-2 rounded-full bg-primary shrink-0"></span>
                                <span class="font-medium text-on-surface">@((_activeProducts * 100 / _totalProducts))%</span>
                            }
                            <span class="truncate">hoạt động</span>
                        </div>
                    </div>
                </div>

                <!-- Total Orders -->
                <div class="bg-surface-container-lowest p-4 rounded-xl shadow-sm flex flex-col justify-between gap-3">
                    <div class="flex items-center justify-between">
                        <span class="font-overline text-overline uppercase text-on-surface-variant font-semibold">Tổng đơn hàng</span>
                        <span class="w-7 h-7 rounded-md bg-surface-container-low flex items-center justify-center text-on-surface">
                            <span class="material-symbols-outlined text-[16px]">receipt_long</span>
                        </span>
                    </div>
                    <div>
                        <div class="font-headline-xl text-headline-xl font-bold tracking-tight text-on-surface">@_totalOrders.ToString("N0")</div>
                        <div class="flex items-center gap-1.5 mt-1 font-body-sm text-body-sm text-on-surface-variant">
                            <span class="truncate">đơn hàng</span>
                        </div>
                    </div>
                </div>

                <!-- Pending Orders - highlighted -->
                <div class="bg-surface-container-lowest p-4 rounded-xl shadow-sm flex flex-col justify-between gap-3 relative overflow-hidden">
                    <div class="absolute top-0 left-0 w-1 h-full bg-error"></div>
                    <div class="flex items-center justify-between">
                        <span class="font-overline text-overline uppercase text-error font-semibold">Đơn chờ xử lý</span>
                        <span class="w-7 h-7 rounded-md bg-error-container text-on-error-container flex items-center justify-center">
                            <span class="material-symbols-outlined text-[16px]">hourglass_top</span>
                        </span>
                    </div>
                    <div>
                        <div class="font-headline-xl text-headline-xl font-bold tracking-tight text-error">
                            @_pendingCount <span class="text-sm font-normal text-on-surface-variant">đơn</span>
                        </div>
                        <div class="mt-1 font-body-sm text-body-sm text-error font-medium">Cần xử lý</div>
                    </div>
                </div>
            </div>

            <!-- Recent Orders Table -->
            <div class="bg-surface-container-lowest rounded-xl shadow-sm p-5 flex flex-col gap-4">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="font-headline-sm text-headline-sm font-bold text-on-surface">Đơn hàng mới nhất</h2>
                        <p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">Danh sách đơn hàng gần đây nhất trong hệ thống</p>
                    </div>
                    <a class="font-label-sm text-label-sm font-semibold text-primary hover:underline flex items-center gap-1 shrink-0" href="/admin/orders">
                        <span>Xem tất cả</span>
                        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                    </a>
                </div>

                @if (_recentOrders.Count == 0)
                {
                    <div class="flex flex-col items-center justify-center py-10 gap-3 text-center">
                        <span class="material-symbols-outlined text-[40px] text-on-surface-variant">inbox</span>
                        <p class="font-body-md text-body-md text-on-surface-variant">Chưa có đơn hàng nào.</p>
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-surface-container-low text-on-surface-variant font-overline text-overline uppercase tracking-wider">
                                    <th class="py-2.5 px-3 rounded-l-lg">Mã đơn</th>
                                    <th class="py-2.5 px-3">Khách hàng</th>
                                    <th class="py-2.5 px-3 text-right">Tổng tiền</th>
                                    <th class="py-2.5 px-3 text-center">Trạng thái</th>
                                    <th class="py-2.5 px-3">Thời gian</th>
                                    <th class="py-2.5 px-3 rounded-r-lg text-right">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-surface-container-low font-body-sm text-body-sm">
                                @foreach (var order in _recentOrders)
                                {
                                    <tr class="hover:bg-surface-container-low/50 transition-colors">
                                        <td class="py-3 px-3 font-semibold text-on-surface">#@order.OrderCode</td>
                                        <td class="py-3 px-3">
                                            <div class="font-medium text-on-surface truncate max-w-[130px]">@order.CustomerName</div>
                                            <div class="text-xs text-on-surface-variant">@MaskPhone(order.Phone)</div>
                                        </td>
                                        <td class="py-3 px-3 font-semibold text-right text-on-surface">@order.TotalAmount.ToString("N0")₫</td>
                                        <td class="py-3 px-3 text-center">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold @GetStatusClass(order.Status)">
                                                @GetStatusLabel(order.Status)
                                            </span>
                                        </td>
                                        <td class="py-3 px-3 text-on-surface-variant text-xs">@order.CreatedAt.ToString("dd/MM HH:mm")</td>
                                        <td class="py-3 px-3 text-right">
                                            <a href="/admin/orders/@order.Id"
                                               class="px-2.5 py-1 text-xs font-semibold rounded bg-surface-container-high hover:bg-primary hover:text-on-primary transition-colors">
                                                Chi tiết
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="flex items-center justify-between bg-surface-container-low/40 px-3 py-2 rounded-lg">
                        <span class="font-body-sm text-body-sm text-on-surface-variant">
                            Hiển thị @_recentOrders.Count / @_totalOrders đơn hàng
                        </span>
                        <a href="/admin/orders" class="font-label-sm text-label-sm font-semibold text-primary hover:underline flex items-center gap-1">
                            <span>Xem thêm</span>
                            <span class="material-symbols-outlined text-[14px]">open_in_new</span>
                        </a>
                    </div>
                }
            </div>
        }

    </section>
        </div>
    </AdminShell>


@code {
    private bool _isLoading = true;
    private bool _hasLoadError;

    private int _totalProducts;
    private int _activeProducts;
    private int _totalStickers;
    private int _activeStickers;
    private int _totalOrders;
    private int _pendingCount;

    private List<OrderSummaryDto> _recentOrders = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        _isLoading = true;
        _hasLoadError = false;
        try
        {
            // The services share the scoped DbContext, so these queries must not
            // execute concurrently on the same request scope.
            var allProducts = await ProductService.GetAllProductsAsync();
            var allStickers = await StickerService.GetAllStickersAsync();
            var allOrders = await OrderService.GetOrdersAsync();

            _totalProducts = allProducts.Count;
            _activeProducts = allProducts.Count(p => p.IsActive);
            _totalStickers = allStickers.Count;
            _activeStickers = allStickers.Count(s => s.IsActive);
            _totalOrders = allOrders.Count;
            _pendingCount = allOrders.Count(o => o.Status == OrderStatus.Pending);

            // Show latest 10 orders
            _recentOrders = allOrders
                .OrderByDescending(o => o.CreatedAt)
                .Take(10)
                .ToList();
        }
        catch
        {
            _hasLoadError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string MaskPhone(string phone)
    {
        if (string.IsNullOrWhiteSpace(phone) || phone.Length < 6) return phone;
        return phone[..4] + "***" + phone[^3..];
    }

    private static string GetStatusLabel(OrderStatus status) => status switch
    {
        OrderStatus.Pending   => "Chờ xác nhận",
        OrderStatus.Confirmed => "Đã xác nhận",
        OrderStatus.Producing => "Đang gia công",
        OrderStatus.Shipping  => "Đang giao",
        OrderStatus.Completed => "Hoàn thành",
        OrderStatus.Cancelled => "Đã hủy",
        _                     => status.ToString()
    };

    private static string GetStatusClass(OrderStatus status) => status switch
    {
        OrderStatus.Pending   => "bg-error-container text-on-error-container",
        OrderStatus.Confirmed => "bg-secondary-container text-on-secondary-fixed",
        OrderStatus.Producing => "bg-secondary-container text-on-secondary-fixed",
        OrderStatus.Shipping  => "bg-surface-container-high text-on-surface",
        OrderStatus.Completed => "bg-surface-container text-on-surface-variant",
        OrderStatus.Cancelled => "bg-surface-container text-on-surface-variant",
        _                     => "bg-surface-container text-on-surface-variant"
    };
}
