@using CaseShop.Web.DTOs
@using CaseShop.Web.Services
@rendermode InteractiveServer
@inject IProductService ProductService
@inject ILogger<HomeTrendingSection> Logger

<section class="w-full bg-surface py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-margin-mobile lg:px-margin">
        <div class="mb-12 flex flex-col justify-between gap-4 md:flex-row md:items-end">
            <div>
                <span class="mb-2 block font-overline text-overline uppercase tracking-widest text-on-secondary-container">Vừa cập nhật</span>
                <h2 class="font-headline-xl text-headline-xl-mobile font-bold text-on-surface lg:text-headline-xl">Sản phẩm tiêu biểu</h2>
                <p class="mt-3 font-body-md text-body-md text-on-surface-variant">Khám phá những mẫu ốp lưng mới nhất tại CASESHOP.</p>
            </div>
            <a class="inline-flex items-center gap-2 font-label-md text-label-md font-semibold text-on-surface transition-colors hover:text-on-secondary-container" href="/shop">
                <span>Xem tất cả sản phẩm</span>
                <span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_forward</span>
            </a>
        </div>

        @if (_isLoading)
        {
            <div class="flex min-h-72 items-center justify-center" aria-live="polite">
                <div class="flex flex-col items-center gap-3">
                    <AppSpinner Size="AppSpinner.SpinnerSize.Large" />
                    <p class="font-body-sm text-body-sm text-on-surface-variant">Đang tải sản phẩm mới...</p>
                </div>
            </div>
        }
        else if (!string.IsNullOrEmpty(_errorMessage))
        {
            <AppEmptyState Icon="error" Title="Không thể tải sản phẩm" Description="@_errorMessage" ButtonText="Thử lại" OnButtonClick="LoadLatestProductsAsync" />
        }
        else if (_products.Count == 0)
        {
            <AppEmptyState Icon="inventory_2" Title="Chưa có sản phẩm" Description="Các sản phẩm mới sẽ sớm xuất hiện tại đây." ButtonText="Tự thiết kế ốp lưng" ButtonLink="/customize" ButtonIcon="brush" />
        }
        else
        {
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
                @foreach (var product in _products)
                {
                    <ProductCard Product="product" />
                }
            </div>
        }
    </div>
</section>

@code {
    private IReadOnlyList<ProductDto> _products = Array.Empty<ProductDto>();
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override Task OnInitializedAsync() => LoadLatestProductsAsync();

    private async Task LoadLatestProductsAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _products = await ProductService.GetLatestActiveProductsAsync(4);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load latest products for the home page");
            _errorMessage = "Vui lòng thử lại sau ít phút.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
