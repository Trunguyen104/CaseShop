@namespace CaseShop.Web.Components.Pages.Editor
@using CaseShop.Web.DTOs
@using CaseShop.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IStorageService StorageService

<aside class="studio-panel lg:col-span-3 h-full flex flex-col bg-surface-container-lowest border-r border-outline-variant z-10 overflow-hidden" aria-label="Công cụ chỉnh sửa">
    <div class="flex items-center p-2 bg-surface-container-low gap-1 overflow-x-auto border-b border-outline-variant">
        <button class="@(_activeTab == "sticker" ? "bg-primary text-on-primary shadow-sm" : "text-on-surface-variant hover:bg-surface") flex-1 py-2 px-1 text-center rounded-md font-label-sm text-label-sm font-medium transition-all"
                @onclick='() => _activeTab = "sticker"'>Sticker</button>
        <button class="@(_activeTab == "upload" ? "bg-primary text-on-primary shadow-sm" : "text-on-surface-variant hover:bg-surface") flex-1 py-2 px-1 text-center rounded-md font-label-sm text-label-sm font-medium transition-all"
                @onclick='() => _activeTab = "upload"'>Tải ảnh</button>
        <button class="@(_activeTab == "text" ? "bg-primary text-on-primary shadow-sm" : "text-on-surface-variant hover:bg-surface") flex-1 py-2 px-1 text-center rounded-md font-label-sm text-label-sm font-medium transition-all"
                @onclick='() => _activeTab = "text"'>Văn bản</button>
        <button class="@(_activeTab == "background" ? "bg-primary text-on-primary shadow-sm" : "text-on-surface-variant hover:bg-surface") flex-1 py-2 px-1 text-center rounded-md font-label-sm text-label-sm font-medium transition-all"
                @onclick='() => _activeTab = "background"'>Màu nền</button>
    </div>
    <div class="flex-1 overflow-y-auto p-4 space-y-5">

        @if (_activeTab == "sticker")
        {
            <CustomizeStickerPanel Stickers="Stickers"
                                  Loading="StickersLoading"
                                  Error="StickersError"
                                  EditorReady="EditorReady"
                                  OnAddSticker="OnAddSticker" />
        }

        @if (_activeTab == "upload")
        {
            <div>
                <div class="flex items-center justify-between mb-2">
                    <span class="font-overline text-overline uppercase tracking-wider text-on-surface-variant font-semibold">Tải lên tuỳ chỉnh</span>
                    <span class="font-label-sm text-label-sm text-on-secondary-container">Tối đa 5MB</span>
                </div>
                <div class="relative group cursor-pointer p-5 rounded-xl bg-surface-container-low hover:bg-surface-container transition-all text-center flex flex-col items-center justify-center gap-2">
                    <div class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center group-hover:scale-105 transition-transform text-on-surface">
                        <span class="material-symbols-outlined text-[20px]">cloud_upload</span>
                    </div>
                    <p class="font-label-md text-label-md font-medium text-on-surface">Kéo thả hoặc tải ảnh lên</p>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">PNG trong suốt, JPG, WEBP</p>
                    <InputFile id="upload-sticker-input"
                               class="absolute inset-0 opacity-0 cursor-pointer"
                               OnChange="HandleUploadFileSelected"
                               accept=".jpg,.jpeg,.png,.webp"
                               aria-label="Chọn ảnh sticker cần tải lên"
                               disabled="@(!EditorReady || UploadInProgress)" />
                </div>
                @if (!string.IsNullOrEmpty(_uploadFileInfo))
                {
                    <p class="mt-2 font-body-sm text-body-sm text-on-surface-variant flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[16px]">image</span> @_uploadFileInfo
                    </p>
                }
                @if (!string.IsNullOrEmpty(EffectiveUploadErrorMessage))
                {
                    <p class="mt-2 font-body-sm text-body-sm text-error flex items-center gap-1.5" role="alert">
                        <span class="material-symbols-outlined text-[16px]">error</span> @EffectiveUploadErrorMessage
                    </p>
                }
                @if (UploadSuccess)
                {
                    <p class="mt-2 font-body-sm text-body-sm text-primary flex items-center gap-1.5" role="status">
                        <span class="material-symbols-outlined text-[16px]">check_circle</span> Tải lên thành công!
                    </p>
                }
                <button id="btn-upload-sticker"
                        class="mt-3 w-full py-2.5 rounded-lg bg-primary text-on-primary hover:bg-neutral-800 font-label-md text-label-md font-semibold transition-colors flex items-center justify-center gap-1.5 shadow-sm"
                        @onclick="HandleUploadSticker"
                        disabled="@(!EditorReady || _selectedUploadFile == null || UploadInProgress)"
                        aria-label="Tải lên và thêm sticker vào canvas">
                    @if (UploadInProgress)
                    {
                        <span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span>
                        <span>Đang tải lên...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-[18px]">upload</span>
                        <span>Tải lên và thêm vào canvas</span>
                    }
                </button>
            </div>
        }

        @if (_activeTab == "text")
        {
            <div class="p-3.5 rounded-xl bg-surface-container-low space-y-3">
                <div class="flex items-center justify-between">
                    <span class="font-overline text-overline uppercase tracking-wider text-on-surface-variant font-semibold">Thêm chữ cá nhân hoá</span>
                    <span class="material-symbols-outlined text-[18px] text-on-surface-variant">title</span>
                </div>
                <input id="text-input"
                       type="text"
                       class="w-full px-3 py-2.5 bg-surface-container-lowest rounded-lg text-on-surface font-headline-sm text-headline-sm focus:outline-none focus:ring-2 focus:ring-primary/20 shadow-sm"
                       placeholder="Nhập tên, số hoặc châm ngôn..."
                       @bind="_textInput"
                       @bind:event="oninput"
                       @onkeydown="HandleTextKeyDown"
                       maxlength="100"
                       aria-label="Nội dung văn bản"
                       disabled="@(!EditorReady)" />
                @if (!string.IsNullOrEmpty(_textErrorMessage))
                {
                    <p class="font-body-sm text-body-sm text-error" role="alert">@_textErrorMessage</p>
                }
                <button id="btn-add-text"
                        class="w-full py-2.5 bg-primary text-on-primary hover:bg-neutral-800 rounded-lg font-label-md text-label-md font-semibold transition-colors flex items-center justify-center gap-1.5 shadow-sm"
                        @onclick="HandleAddText"
                        disabled="@(!EditorReady || string.IsNullOrWhiteSpace(_textInput))"
                        aria-label="Thêm văn bản vào canvas">
                    <span class="material-symbols-outlined text-[16px]">add_circle</span>
                    Chèn vào canvas
                </button>
            </div>
        }

        @if (_activeTab == "background")
        {
            <div class="space-y-4">
                <label class="block text-label-md font-semibold text-on-surface">Màu nền bản in
                    <input type="color" value="#ffffff" @onchange="HandleColorChanged" disabled="@(!EditorReady)" class="mt-2 w-full h-10 rounded-lg cursor-pointer bg-surface-container-low" />
                </label>

                <!-- Tải ảnh nền trực tiếp từ máy (Xem trước JS - không lưu database) -->
                <div class="p-3.5 rounded-xl bg-surface-container-low space-y-2.5">
                    <div class="flex items-center justify-between">
                        <span class="font-overline text-overline uppercase tracking-wider text-on-surface-variant font-semibold">Tải ảnh nền từ thiết bị</span>
                        <span class="material-symbols-outlined text-[18px] text-primary">add_photo_alternate</span>
                    </div>
                    <div class="relative group cursor-pointer p-4 rounded-xl border-2 border-dashed border-outline-variant hover:border-primary bg-surface-container-lowest text-center flex flex-col items-center justify-center gap-1.5 transition-all">
                        <span class="material-symbols-outlined text-[24px] text-primary group-hover:scale-110 transition-transform">upload_file</span>
                        <p class="font-label-sm text-label-sm font-medium text-on-surface">Chọn ảnh từ thiết bị</p>
                        <p class="text-[11px] text-on-surface-variant">Xem trước tức thì, không lưu DB</p>
                        <InputFile id="bg-file-input"
                                   class="absolute inset-0 opacity-0 cursor-pointer"
                                   OnChange="HandleBackgroundFileSelected"
                                   accept=".jpg,.jpeg,.png,.webp"
                                   aria-label="Chọn ảnh nền xem trước"
                                   disabled="@(!EditorReady)" />
                    </div>
                    @if (!string.IsNullOrEmpty(_bgFileName))
                    {
                        <div class="flex items-center justify-between text-xs text-on-surface-variant px-1">
                            <span class="truncate max-w-[180px] font-medium text-primary">📁 @_bgFileName</span>
                            <button class="text-error hover:underline font-semibold" @onclick="HandleClearBackground">Gỡ ảnh</button>
                        </div>
                    }
                </div>

                <div class="space-y-3">
                    <span class="font-overline text-overline uppercase tracking-wider text-on-surface-variant font-semibold block">Hoặc dán URL hình nền</span>
                    @if (!string.IsNullOrEmpty(_bgErrorMessage))
                    {
                        <p class="font-body-sm text-body-sm text-error" role="alert">@_bgErrorMessage</p>
                    }
                    <input id="bg-url-input"
                           type="url"
                           class="w-full px-3 py-2.5 bg-surface-container-low rounded-lg text-on-surface font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary/20"
                           placeholder="Dán URL hình ảnh..."
                           @bind="_backgroundUrl"
                           @bind:event="oninput"
                           aria-label="URL hình nền"
                           disabled="@(!EditorReady)" />
                    <div class="flex items-center gap-2">
                        <button id="btn-set-bg"
                                class="flex-1 py-2.5 rounded-lg bg-primary text-on-primary hover:bg-neutral-800 font-label-md text-label-md font-semibold transition-colors shadow-sm"
                                @onclick="HandleSetBackground"
                                disabled="@(!EditorReady || string.IsNullOrWhiteSpace(_backgroundUrl))"
                                aria-label="Đặt hình nền">
                            Đặt nền
                        </button>
                        <button id="btn-clear-bg"
                                class="flex-1 py-2.5 rounded-lg bg-surface-container text-on-surface hover:bg-surface-container-high font-label-md text-label-md font-semibold transition-colors"
                                @onclick="HandleClearBackground"
                                disabled="@(!EditorReady)"
                                aria-label="Xóa hình nền">
                            Xoá nền
                        </button>
                    </div>
                </div>
            </div>
        }

    </div>
</aside>

@code {
    [Parameter] public bool EditorReady { get; set; }
    [Parameter] public IReadOnlyList<StickerDto>? Stickers { get; set; }
    [Parameter] public bool StickersLoading { get; set; }
    [Parameter] public bool StickersError { get; set; }
    [Parameter] public EventCallback<StickerDto> OnAddSticker { get; set; }
    [Parameter] public EventCallback<IBrowserFile> OnUploadSticker { get; set; }
    [Parameter] public bool UploadInProgress { get; set; }
    [Parameter] public string? UploadErrorMessage { get; set; }
    [Parameter] public bool UploadSuccess { get; set; }
    [Parameter] public EventCallback<string> OnAddText { get; set; }
    [Parameter] public EventCallback<string> OnSetBackground { get; set; }
    [Parameter] public EventCallback OnClearBackground { get; set; }
    [Parameter] public EventCallback<string> OnChangeBackgroundColor { get; set; }

    private string _activeTab = "sticker";

    // Text state
    private string _textInput = string.Empty;
    private string? _textErrorMessage;

    // Background state
    private string _backgroundUrl = string.Empty;
    private string? _bgErrorMessage;
    private string? _bgFileName;

    // Upload state
    private IBrowserFile? _selectedUploadFile;
    private string? _uploadFileInfo;
    private string? _localUploadError;

    private string? EffectiveUploadErrorMessage => _localUploadError ?? UploadErrorMessage;

    private async Task HandleBackgroundFileSelected(InputFileChangeEventArgs e)
    {
        if (!EditorReady) return;
        _bgErrorMessage = null;
        var file = e.File;
        if (file == null) return;

        if (!StorageService.IsValidImageFile(file.Name, file.ContentType, file.Size))
        {
            _bgErrorMessage = "File không hợp lệ. Chỉ chấp nhận JPG, PNG, WEBP và tối đa 5MB.";
            return;
        }

        try
        {
            // Đọc file thành base64 data URL để xem trước tức thì trên canvas (client-side JS), không lưu DB
            const long maxFileSize = 10 * 1024 * 1024; // 10MB
            using var stream = file.OpenReadStream(maxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());
            var mimeType = string.IsNullOrEmpty(file.ContentType) ? "image/jpeg" : file.ContentType;
            var dataUrl = $"data:{mimeType};base64,{base64}";

            _bgFileName = file.Name;
            _backgroundUrl = string.Empty;
            await OnSetBackground.InvokeAsync(dataUrl);
        }
        catch (Exception ex)
        {
            _bgErrorMessage = $"Không thể đọc file: {ex.Message}";
        }
    }

    private void HandleUploadFileSelected(InputFileChangeEventArgs e)
    {
        _localUploadError = null;
        var file = e.File;
        if (file == null)
        {
            _selectedUploadFile = null;
            _uploadFileInfo = null;
            return;
        }

        if (!StorageService.IsValidImageFile(file.Name, file.ContentType, file.Size))
        {
            _localUploadError = "File không hợp lệ. Chỉ chấp nhận JPG, PNG, WEBP và tối đa 5MB.";
            _selectedUploadFile = null;
            _uploadFileInfo = null;
            return;
        }

        _selectedUploadFile = file;
        var sizeKb = file.Size / 1024.0;
        var sizeDisplay = sizeKb >= 1024 ? $"{sizeKb / 1024:F1} MB" : $"{sizeKb:F0} KB";
        _uploadFileInfo = $"{file.Name} ({sizeDisplay})";
    }

    private async Task HandleUploadSticker()
    {
        if (_selectedUploadFile == null || UploadInProgress) return;
        await OnUploadSticker.InvokeAsync(_selectedUploadFile);
        if (UploadSuccess)
        {
            _selectedUploadFile = null;
            _uploadFileInfo = null;
        }
    }

    private async Task HandleAddText()
    {
        if (!EditorReady) return;
        _textErrorMessage = null;
        var text = _textInput.Trim();
        if (string.IsNullOrWhiteSpace(text))
        {
            _textErrorMessage = "Vui lòng nhập nội dung văn bản.";
            return;
        }
        await OnAddText.InvokeAsync(text);
        _textInput = string.Empty;
    }

    private async Task HandleTextKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleAddText();
    }

    private async Task HandleColorChanged(ChangeEventArgs e)
    {
        var color = e.Value?.ToString() ?? "#ffffff";
        await OnChangeBackgroundColor.InvokeAsync(color);
    }

    private async Task HandleSetBackground()
    {
        if (!EditorReady) return;
        _bgErrorMessage = null;
        var url = _backgroundUrl.Trim();
        if (string.IsNullOrWhiteSpace(url))
        {
            _bgErrorMessage = "Vui lòng nhập URL hình ảnh hợp lệ.";
            return;
        }
        if (!url.StartsWith("http://", StringComparison.OrdinalIgnoreCase) &&
            !url.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            _bgErrorMessage = "URL phải bắt đầu bằng http:// hoặc https://";
            return;
        }
        await OnSetBackground.InvokeAsync(url);
    }

    private async Task HandleClearBackground()
    {
        _backgroundUrl = string.Empty;
        _bgFileName = null;
        _bgErrorMessage = null;
        await OnClearBackground.InvokeAsync();
    }
}
