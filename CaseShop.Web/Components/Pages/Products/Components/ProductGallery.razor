<section class="lg:col-span-7 flex flex-col gap-5 @Class">
    <!-- Main Image -->
    <div class="relative w-full aspect-[4/5] bg-surface-container-low rounded-xl overflow-hidden shadow-sm flex items-center justify-center p-8 group">
        <div class="absolute inset-0 bg-gradient-to-tr from-surface-container-high/30 via-transparent to-surface-container-lowest/40 pointer-events-none"></div>

        <div class="relative w-full h-full flex items-center justify-center">
            @if (!string.IsNullOrEmpty(ImageUrl))
            {
                <img alt="@ProductName" class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-105 select-none pointer-events-none" src="@ImageUrl" />
            }
            else
            {
                <div class="flex flex-col items-center gap-3 text-on-surface-variant">
                    <span class="material-symbols-outlined text-[64px]">image_not_supported</span>
                    <p class="font-body-sm">Chưa có hình ảnh</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    [Parameter]
    public string? ImageUrl { get; set; }

    [Parameter]
    public string? ProductName { get; set; }

    [Parameter]
    public string Class { get; set; } = "";
}
